# Contatos: a URL do Apps Script fica apenas no servidor.
# VITE_CONTACT_TURNSTILE_SITE_KEY=public_widget_key
# CONTACT_TURNSTILE_SECRET=server_secret
# CONTACT_RATE_SECRET=random_stable_secret
# CONTACT_FORM_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# CONTACT_RELAY_TOKEN=random_shared_secret
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server_only
# CONTACT_COS_TELEGRAM_BOT_TOKEN=existing_cos_bot_token
# CONTACT_COS_TELEGRAM_CHAT_ID=existing_cos_chat_id
# Alternativa ao Telegram:
# CONTACT_COS_WEBHOOK_URL=https://your-service.example/contact-events
# CONTACT_COS_WEBHOOK_TOKEN=server_only
# CRON_SECRET=random_secret
# Apps Script properties: CONTACT_RELAY_TOKEN e CONTACT_NOTIFICATION_EMAIL.
# Ativação: docs/google-apps-script-contact-form.md

# Opcional: no dev local, /api/cgi-assessment pode chamar a API publicada
# para usar as env vars da Vercel, OpenAI e Apps Script.
# VITE_CGI_API_ORIGIN=https://www.caldeiragrowth.com

# Artigos dinâmicos via Google Sheets publicado como CSV direto.
# VITE_ARTICLES_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?gid=0&single=true&output=csv
#
# Mídia dinâmica via Google Sheets publicado como CSV direto.
# VITE_MEDIA_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?gid=123456789&single=true&output=csv

# CGI Pipeline (mini CRM, /admin/crm) -- somente a URL e a anon/publishable key do Supabase.
# Seguro para o bundle do cliente por design: todo acesso é filtrado por RLS no banco.
# NUNCA colocar aqui a SUPABASE_SERVICE_ROLE_KEY (essa fica só nas funções serverless em api/).
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY
